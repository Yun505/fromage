{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist"
    // rootDir removed — with no src/ subfolder, TypeScript infers
    // the root as the lowest common folder of all included files,
    // which is correct here
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}